# Copy this file to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=4000

# PostgreSQL (local during development, Neon after deployment)
DATABASE_URL="postgresql://community_board:CHANGE_ME@localhost:5432/community_board?schema=public"

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# Cookie: lax (default, works with the /api proxy) or none (cross-domain fallback, needs https)
COOKIE_SAMESITE=lax

# CORS: the frontend origin (Swagger and fallback cross-domain setup)
CLIENT_URL=http://localhost:3000

# Public address of the website. Used for the link inside verification emails.
SITE_URL=http://localhost:3000

# Cloudinary (day 4)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (day 5)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Community Board

# University email domains (feature 24). Optional: comma separated, replaces the placeholder list in
# server/src/config/university-domains.ts. Example: ALLOWED_UNIVERSITY_DOMAINS=tgu.tj,ttu.tj
ALLOWED_UNIVERSITY_DOMAINS=

# Only for automated tests: THROTTLE_DISABLED=true switches the rate limits off. Never use it in production.
# THROTTLE_DISABLED=false
